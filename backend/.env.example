POSTGRES_DB=${POSTGRES_DB:-events}
POSTGRES_USER=${POSTGRES_USER:-events}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-change-me}
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER:-events}:${POSTGRES_PASSWORD:-change-me}@db:5432/${POSTGRES_DB:-events}
APP_NAME=Together Events API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=${JWT_SECRET:-replace-this-development-secret-before-use}
ACCESS_TOKEN_MINUTES=${ACCESS_TOKEN_MINUTES:-15}
REFRESH_TOKEN_DAYS=${REFRESH_TOKEN_DAYS:-7}
UPLOAD_DIR=/app/uploads
API_PROXY_TARGET=http://backend:8000
